{
    "$schema": "http://json.schemastore.org/template",
    "author": "Mateusz Podeszwa",
    "classifications": ["Console", "MVC"],
    "identity": "ConsoleMVC.App",
    "name": "ConsoleMVC Application",
    "shortName": "consolemvc",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "sourceName": "ConsoleMVC.App",
    "preferNameDirectory": true,
    "symbols": {
        "tests": {
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "false",
            "description": "Adds an xUnit test project (MyApp.Tests) that runs the application with ConsoleMVC.Testing and checks a snapshot."
        }
    },
    "sources": [
        {
            "modifiers": [
                {
                    "condition": "(!tests)",
                    "exclude": ["ConsoleMVC.App.Tests/**"]
                }
            ]
        }
    ]
}
