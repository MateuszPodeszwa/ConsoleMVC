@model ConsoleMVC.App.Models.StatusViewModel
@* @refresh draws the page again every second (the action runs again) until you start typing *@
@refresh 1s

<box title="Status" class="panel" padding="1">
    <spinner label="Refreshing every second until you type" frame="@Model.Time.Second" class="success" />
    <text>Time: @Model.Time.ToString("HH:mm:ss")</text>
    <progress label="Services up " value="@Model.Healthy" max="@Model.Total" bar-width="20" class="success" />
</box>
<br />

<menu key-color="cyan">
    <option key="b" back>Back</option>
    <option key="q" quit>Exit</option>
</menu>
