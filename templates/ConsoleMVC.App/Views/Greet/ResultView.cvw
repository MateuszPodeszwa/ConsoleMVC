@model ConsoleMVC.App.Models.GreetResultModel

<box title="Greeting" border="rounded" color="green" padding="2">
    <text bold>@Model.Greeting</text>
    <separator color="darkgrey" />
    <text>[1] Submit another greeting</text>
    <text>[2] Back to Home</text>
    <text>[3] Exit</text>
</box>

Console.Write("Select an option: ");
var input = Console.ReadLine()?.Trim();

return input switch
{
    "1" => NavigationResult.ToAction("Index"),
    "2" => NavigationResult.To("Home", "Index"),
    _ => NavigationResult.Quit()
};
