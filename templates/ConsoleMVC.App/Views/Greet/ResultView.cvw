@model ConsoleMVC.App.Models.GreetResultModel

<box title="Greeting" border="rounded" color="green" padding="2">
    <text bold>@Model.Greeting</text>
</box>
<br />

<menu key-color="green">
    <option key="1" nav="Index">Submit another greeting</option>
    <option key="2" nav="Home/Index">Back to Home</option>
    <option key="q" quit>Exit</option>
</menu>
