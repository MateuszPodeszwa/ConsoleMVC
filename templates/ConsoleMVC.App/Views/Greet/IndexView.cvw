@model object

<box title="Greeting Form" border="rounded" color="green">
    <text>Fill in the form below and answer each field.</text>
</box>
<br />

@* Shows validation errors when the form is shown again after an invalid submission *@
<errors />

@* Each field stores its value in Form under its name. Posting Form to the Result
   action binds the values to the GreetFormModel parameter of GreetController.Result. *@
<input name="Name" label="  Name: " required />

@* <select> offers fixed choices: arrow keys and Enter in a terminal, or type a number *@
<select name="Color" label="  Favourite colour:" default="blue">
    <choice value="red">Red</choice>
    <choice value="green">Green</choice>
    <choice value="blue">Blue</choice>
    <choice value="">No favourite</choice>
</select>

@* <checkbox> posts "true" or "false", which binds to a bool *@
<checkbox name="Shout" label="  Shout the greeting" />

return NavigationResult.ToAction("Result", Form);
