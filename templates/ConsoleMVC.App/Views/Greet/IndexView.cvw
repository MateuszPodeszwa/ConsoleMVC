@model object

<box title="Greeting Form" border="rounded" color="green">
    <text>Fill in the form below and press Enter after each field.</text>
</box>
<br />

@* Shows validation errors when the form is shown again after an invalid submission *@
<errors />

@* Each <input> stores its value in Form under its name. Posting Form to the Result
   action binds the values to the GreetFormModel parameter of GreetController.Result. *@
<input name="Name" label="  Name: " required />
<input name="Color" label="  Favourite colour: " />

return NavigationResult.ToAction("Result", Form);
