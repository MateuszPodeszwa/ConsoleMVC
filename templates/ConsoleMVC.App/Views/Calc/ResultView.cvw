@model ConsoleMVC.App.Models.CalcResultModel

<box title="Calculator" border="rounded" color="yellow" padding="2">
    <text bold>@Model.Expression = @Model.Result</text>
    <separator color="darkgrey" />
    <text>[1] Calculate again</text>
    <text>[2] Back to Home</text>
    <text>[3] Exit</text>
</box>

Console.Write("Select an option: ");
var input = Console.ReadLine()?.Trim();

return input switch
{
    "1" => NavigationResult.ToAction("Index"),
    "2" => NavigationResult.To("Home", "Index"),
    _ => NavigationResult.Quit()
};
