@model object

<box title="Calculator" border="rounded" color="yellow">
    <text>Enter two whole numbers and an operator.</text>
</box>
<br />

@* The values are posted individually and bound by name to the parameters of
   CalcController.Result(int a, int b, string op). *@
<input name="a" label="  First number:  " default="0" />
<input name="op" label="  Operator (+, -, *, /): " default="+" />
<input name="b" label="  Second number: " default="0" />

return NavigationResult.ToAction("Result", Form);
