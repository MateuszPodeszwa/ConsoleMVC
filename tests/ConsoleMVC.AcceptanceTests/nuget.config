<?xml version="1.0" encoding="utf-8"?>
<!-- The packages under test come from artifacts/feed (packed from this repository); the rest from nuget.org -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="ConsoleMVC.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
