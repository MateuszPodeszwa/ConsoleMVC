<Project Sdk="Microsoft.NET.Sdk">

    <!-- Acceptance tests of the packed packages, written as an application would use them: they reference
         ConsoleMVC.Framework and ConsoleMVC.Testing from a local feed (not the projects), compile real .cvw views
         with the packaged generator, and run the application with scripted input. See readme.md, "Acceptance tests".
         Run after packing into artifacts/feed:
           dotnet pack src/ConsoleMVC/ConsoleMVC.csproj -c Release -o artifacts/feed
           dotnet pack src/ConsoleMVC.Testing/ConsoleMVC.Testing.csproj -c Release -o artifacts/feed
           dotnet test tests/ConsoleMVC.AcceptanceTests -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Acceptance</RootNamespace>
        <!-- The version being released, read from the framework's project so the two never drift apart -->
        <ConsoleMVCVersion Condition="'$(ConsoleMVCVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../src/ConsoleMVC/ConsoleMVC.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</ConsoleMVCVersion>
        <!-- A separate package cache, so a package packed again under the same version is never read from an older copy -->
        <RestorePackagesPath>$(MSBuildThisFileDirectory)../../artifacts/packages</RestorePackagesPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ConsoleMVC.Framework" Version="$(ConsoleMVCVersion)" />
        <PackageReference Include="ConsoleMVC.Testing" Version="$(ConsoleMVCVersion)" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
