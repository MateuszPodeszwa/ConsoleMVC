<Project>

    <!-- Auto-include .cvw view files (Views and Areas/{Area}/Views) as AdditionalFiles for the source generator -->
    <ItemGroup>
        <AdditionalFiles Include="Views/**/*.cvw" />
        <AdditionalFiles Include="Areas/**/*.cvw" />
    </ItemGroup>

    <!-- Expose RootNamespace to the source generator so it can use the consumer's namespace -->
    <ItemGroup>
        <CompilerVisibleProperty Include="RootNamespace" />
        <!-- <ConsoleMVCModule>true</ConsoleMVCModule> in a module added with AddModule(assembly): the build checks then
             do not report the application's controllers, which the module cannot see, as unknown -->
        <CompilerVisibleProperty Include="ConsoleMVCModule" />
    </ItemGroup>

    <!-- dotnet watch: rebuild or hot reload when a .cvw view changes (views are AdditionalFiles, which it does not watch) -->
    <ItemGroup>
        <Watch Include="Views/**/*.cvw" />
        <Watch Include="Areas/**/*.cvw" />
    </ItemGroup>

    <!-- IDE (Visual Studio / Rider) fast up-to-date check: treat .cvw edits as build inputs -->
    <ItemGroup>
        <UpToDateCheckInput Include="Views/**/*.cvw" />
        <UpToDateCheckInput Include="Areas/**/*.cvw" />
    </ItemGroup>

</Project>
