<Project Sdk="Microsoft.NET.Sdk">

    <!-- Code fixes for the ConsoleMVC diagnostics. Kept apart from the generator because code fixes need the Roslyn
         workspace, which compilers do not load; IDEs load both from the framework package's analyzers folder. -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" PrivateAssets="all" />
    </ItemGroup>

</Project>
